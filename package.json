{
  "name": "isaiah-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute isaiah-store-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute isaiah-store-db --remote --file=./schema.sql",
    "db:migrate:add-image:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_image_url.sql",
    "db:migrate:add-image:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_image_url.sql",
    "db:migrate:uppercase-names:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/uppercase_customer_names.sql",
    "db:migrate:uppercase-names:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/uppercase_customer_names.sql",
    "db:migrate:add-features:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_ux_features.sql",
    "db:migrate:add-features:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_ux_features.sql",
    "db:migrate:add-logo:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_logo.sql",
    "db:migrate:add-logo:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_logo.sql",
    "db:migrate:add-categories-table:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_categories_table.sql",
    "db:migrate:add-categories-table:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_categories_table.sql",
    "db:migrate:add-category:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_category.sql",
    "db:migrate:add-category:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_category.sql",
    "db:migrate:add-utang-profit:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_utang_profit.sql",
    "db:migrate:add-utang-profit:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_utang_profit.sql",
    "db:migrate:add-barcode:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_barcode.sql",
    "db:migrate:add-barcode:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_barcode.sql",
    "db:migrate:add-expenses:local": "wrangler d1 execute isaiah-store-db --local --file=./migrations/add_expenses.sql",
    "db:migrate:add-expenses:remote": "wrangler d1 execute isaiah-store-db --remote --file=./migrations/add_expenses.sql",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.28.0"
  }
}
